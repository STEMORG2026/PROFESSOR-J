# MCP Agent Secrets — Copy to mcp_agent.secrets.yaml and fill in values
# NEVER commit this file! It's in .gitignore

mcp:
  servers:
    github:
      env:
        GITHUB_PERSONAL_ACCESS_TOKEN: "ghp_xxxxxxxxxxxxxxxxxxxx"

    postgres:
      env:
        DATABASE_URL: "postgresql://user:pass@localhost:5432/professor"

    brave-search:
      env:
        BRAVE_API_KEY: "BSA_xxxxxxxxxxxxxxxxxxxx"

    slack:
      env:
        SLACK_BOT_TOKEN: "xoxb-xxxxxxxxxxxxxxxxxxxx"
        SLACK_TEAM_ID: "Txxxxxxxx"
